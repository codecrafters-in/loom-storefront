# Netlify and Cloudflare Pages read this; Vercel reads vercel.json. Same rules,
# because a security header that only exists on one host is a header you cannot
# rely on.
#
# The rest of the Content-Security-Policy is a <meta> tag that `npm run build`
# writes into every page (scripts/csp.mjs), because it depends on the build:
# the API origin and the hash of each page's inline scripts. `frame-ancestors`
# is the one directive a meta tag cannot carry, so it lives here, and in
# vercel.json. Nobody gets to frame the shop — that is how clickjacking works.

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
