# Copy to .env. Never commit it.
PORT=8787

# Where the storefront is served from. Used for CORS and for the URLs a payment
# provider redirects back to.
STOREFRONT_ORIGIN=http://localhost:5173

# ── Razorpay ─────────────────────────────────────────────────────────────
# key_id is public and also goes in the storefront's Settings → Payments.
# key_secret is not, and must only ever exist here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set this in the Razorpay dashboard under Webhooks, then paste it here.
RAZORPAY_WEBHOOK_SECRET=

# ── Where the money is decided ───────────────────────────────────────────
# The server refuses to charge an amount the browser sent it. Point this at
# your store API and it prices the cart itself.
STORE_API=http://localhost:8080

# ── Email ────────────────────────────────────────────────────────────────
# For Gmail: an App Password, not your account password. Google will refuse
# the account password, and an App Password can be revoked on its own.
# myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=Your Shop <you@gmail.com>
MAIL_REPLY_TO=

# Guards the admin routes. Any long random string; send it as
# `authorization: Bearer <this>`.
ADMIN_TOKEN=
