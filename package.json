{
  "name": "loom-storefront",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "A production-shaped clothing storefront theme. Runs on bundled mock data out of the box, or against your own API by flipping one environment variable.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && node scripts/check-docs.mjs && node --test test/ && node scripts/brand.mjs && vite build && node scripts/prerender.mjs && node scripts/sitemap.mjs",
    "preview": "vite preview",
    "lint": "eslint src scripts test",
    "images": "node scripts/images.mjs",
    "images:force": "node scripts/images.mjs --force",
    "brand": "node scripts/brand.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test test/",
    "test:watch": "node --test --watch test/",
    "prerender": "node scripts/prerender.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
