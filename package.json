{
  "name": "loom-storefront",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source React e-commerce storefront. Prerendered for SEO with Product JSON-LD, CRO built in, and AI prompts that generate your backend. Runs on bundled demo data or your own API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && node scripts/check-docs.mjs && node scripts/contrast.mjs && node scripts/responsive.mjs && node --test \"test/**/*.test.mjs\" && node scripts/brand.mjs && vite build && node scripts/budget.mjs && node scripts/prerender.mjs && node scripts/sitemap.mjs && node scripts/robots.mjs && node scripts/csp.mjs",
    "preview": "vite preview",
    "lint": "eslint src scripts test",
    "images": "node scripts/images.mjs",
    "images:force": "node scripts/images.mjs --force",
    "brand": "node scripts/brand.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/**/*.test.mjs\"",
    "prerender": "node scripts/prerender.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "responsive": "node scripts/responsive.mjs",
    "responsive:force": "node scripts/responsive.mjs --force",
    "robots": "node scripts/robots.mjs",
    "csp": "node scripts/csp.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "check:budget": "node scripts/budget.mjs",
    "e2e": "npm --prefix e2e test --"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  },
  "keywords": [
    "ecommerce",
    "storefront",
    "react",
    "vite",
    "headless-commerce",
    "seo",
    "ssg",
    "prerendering",
    "json-ld",
    "cro",
    "tailwindcss",
    "shopify-alternative",
    "ecommerce-template",
    "razorpay"
  ],
  "author": "CodeCrafters <hello@codecrafters.in>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecrafters-in/loom-storefront.git"
  },
  "bugs": {
    "url": "https://github.com/codecrafters-in/loom-storefront/issues"
  },
  "homepage": "https://github.com/codecrafters-in/loom-storefront#readme",
  "engines": {
    "node": ">=22"
  }
}
