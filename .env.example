# ─── Data source ──────────────────────────────────────────────────────────
# "mock" runs the whole storefront on the bundled catalogue with no backend at
# all — this is the default, and what the public demo is built from.
# "api"  sends every read and write to VITE_API_BASE_URL instead.
VITE_DATA_SOURCE=mock

# Required when VITE_DATA_SOURCE=api. No trailing slash.
VITE_API_BASE_URL=https://api.example.com/v1

# Optional. Sent as `Authorization: Bearer <token>` on every request.
# For a public storefront this should be a publishable key, never a secret one —
# anything in a VITE_ variable is compiled into the JavaScript bundle.
VITE_API_TOKEN=

# Milliseconds before a request is aborted. Default 12000.
VITE_API_TIMEOUT=12000

# "off" stops caching API responses (in the storefront and in the browser), so a
# change made in the backend shows on the next page load. Use it while building
# the shop against a live backend; leave it on for a real store. Default on.
VITE_API_CACHE=on

# Mock mode only: fake network delay in ms, so loading states are exercised
# during development rather than discovered broken against a real API. 0 disables.
VITE_MOCK_LATENCY=220

# ─── Store ────────────────────────────────────────────────────────────────
VITE_STORE_NAME=LOOM
VITE_CURRENCY=USD
VITE_LOCALE=en-US
VITE_FREE_SHIPPING_OVER=150

# Shown in the footer so a fork can point at its own repo.
VITE_REPO_URL=https://github.com/codecrafters-in/loom-storefront

# ─── Deployment ───────────────────────────────────────────────────────────
# The public origin, used at BUILD time for canonical tags, Open Graph URLs,
# sitemap.xml and robots.txt. Not VITE_ prefixed: the build scripts read it,
# the browser never does.
#
# Leave it unset on Vercel — VERCEL_PROJECT_PRODUCTION_URL is picked up
# automatically, so a fork that just clicks deploy still canonicalises to its
# own domain. Set it anywhere else, or the build falls back to a placeholder
# and says so.
SITE_URL=https://yourshop.com

# ─── Admin (mock mode only) ───────────────────────────────────────────────
# The demo back office at /admin. These are compiled into the JavaScript
# bundle, so they are public — they gate a localStorage demo, nothing more.
# In api mode your server authenticates POST /admin/auth/login and these are
# ignored. Never treat a VITE_ variable as a secret.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=admin
